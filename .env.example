NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose to the browser / NEXT_PUBLIC_*
SUPABASE_SERVICE_ROLE_KEY=
ACCESS_CODE_ENCRYPTION_KEY=
ACCESS_CODE_HMAC_SECRET=
BOOKING_SESSION_SECRET=
# Canonical public origin for QR, receipts, and copy-link. Required in production.
# Example: https://your-production-domain.example
NEXT_PUBLIC_APP_URL=

# Signed public receipt lifetime in days (1–120). Default 30.
# RECEIPT_TTL_DAYS=30

# Access-code verification brute-force guard (server-side).
# ACCESS_CODE_RATE_LIMIT_MAX=8
# ACCESS_CODE_RATE_LIMIT_WINDOW_SECONDS=900
# ACCESS_CODE_RATE_LIMIT_COOLDOWN_SECONDS=600

# Optional: force runtime to treat the process as production (fails without Supabase).
# Required for Cloudflare Workers preview/deploy when you want hard Supabase enforcement.
# WARKA_RUNTIME_ENV=production

# Cloudflare Workers (OpenNext):
# - Local Workers preview: copy values into `.dev.vars` (see `.dev.vars.example`). Never commit `.dev.vars`.
# - Production deploy (later): set secrets with `npx wrangler secret put <NAME>` —
#   SUPABASE_SERVICE_ROLE_KEY, ACCESS_CODE_ENCRYPTION_KEY, ACCESS_CODE_HMAC_SECRET,
#   BOOKING_SESSION_SECRET. Public values can use wrangler `vars` or secrets.
# - Production MUST use Supabase for DB/Auth/Storage. Local `.data/` / `public/uploads` persistence
#   is forbidden when WARKA_RUNTIME_ENV/NODE_ENV indicates production.

# IGNORED in production. Local demo (.data/warka-db.json) is never allowed when
# NODE_ENV/VERCEL/WARKA_RUNTIME_ENV indicates production.
# WARKA_ALLOW_LOCAL_DEMO=true
